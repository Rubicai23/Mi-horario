{
  "name": "mi-horario",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Horario diario con rachas, sincronizado con Firebase. PWA y app nativa con Capacitor.",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run cap:sync && cap open android",
    "cap:ios": "npm run cap:sync && cap open ios",
    "android:prepare": "node scripts/android-prepare.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/local-notifications": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "firebase": "^12.13.0",
    "@capacitor/app": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "vite": "^7.0.0",
    "@capacitor/assets": "^3.0.5"
  }
}
